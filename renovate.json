{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "pin": {
    "commitMessageAction": "pin"
  },
  "pinDigest": {
    "commitMessageAction": "pin"
  },
  "rangeStrategy": "pin",
  "pinDigests": true,
  "packageRules": [
    {
      "groupName": "frontend major updates",
      "groupSlug": "frontend-major",
      "matchManagers": [
        "bun"
      ],
      "minimumReleaseAge": "3 days",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!@biomejs/biome"
      ],
      "automerge": true
    },
    {
      "groupName": "frontend minor and patch updates",
      "groupSlug": "frontend-minor-and-patch",
      "matchManagers": [
        "bun"
      ],
      "minimumReleaseAge": "3 days",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchPackageNames": [
        "!@biomejs/biome"
      ],
      "automerge": true
    },
    {
      "groupName": "Biome",
      "groupSlug": "biome",
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "groupName": "Rust major updates",
      "groupSlug": "rust-major",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true
    },
    {
      "groupName": "Rust minor and patch updates",
      "groupSlug": "rust-minor-and-patch",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "Rust major updates",
      "groupSlug": "rust-major",
      "matchManagers": [
        "cargo"
      ],
      "matchDatasources": [
        "crate"
      ],
      "matchCurrentVersion": "< 1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "Docker images",
      "groupSlug": "docker-images",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "automerge": true
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    }
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "automerge": true
}
