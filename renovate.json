{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "customManagers:biomeVersions"],
  "commitMessagePrefix": "chore(deps):",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "rangeStrategy": "pin",
  "pinDigests": true,
  "packageRules": [
    {
      "groupName": "frontend major updates",
      "groupSlug": "frontend-major",
      "matchManagers": ["npm"],
      "excludePackageNames": ["@biomejs/biome"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "frontend minor and patch updates",
      "groupSlug": "frontend-minor-and-patch",
      "matchManagers": ["npm"],
      "excludePackageNames": ["@biomejs/biome"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "Biome",
      "groupSlug": "biome",
      "matchPackageNames": ["@biomejs/biome"]
    },
    {
      "groupName": "Rust major updates",
      "groupSlug": "rust-major",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "Rust minor and patch updates",
      "groupSlug": "rust-minor-and-patch",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "groupName": "Docker images",
      "groupSlug": "docker-images",
      "matchManagers": ["dockerfile", "docker-compose"]
    },
    {
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ]
}
