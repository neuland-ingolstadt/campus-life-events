  "query": "\n                UPDATE oauth_authorization_codes\n                SET used_at = NOW()\n                WHERE code_hmac = $1 AND used_at IS NULL AND expires_at > NOW()\n                RETURNING client_id, account_id, redirect_uri, code_challenge,\n                          code_challenge_method, resource\n                ",
