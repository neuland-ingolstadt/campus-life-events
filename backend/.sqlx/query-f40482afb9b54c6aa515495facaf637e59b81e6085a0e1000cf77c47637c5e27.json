  "query": "\n        SELECT p.id, p.client_id, p.redirect_uri, p.state, p.expires_at, p.consumed_at,\n               c.client_name\n        FROM oauth_pending_requests p\n        JOIN oauth_clients c ON c.id = p.client_id\n        WHERE p.id = $1\n        ",
